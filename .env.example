# Free local portfolio mode — no Docker / Redis / Postgres / paid APIs required.
# Copy to .env:  cp .env.example .env
# Run:           ./scripts/run_local.sh

APP_ENV=development
APP_NAME=AI Meeting Assistant
APP_BASE_URL=http://localhost:8000
SECRET_KEY=replace-me-with-a-long-random-string
AUTH_MODE=dev
ACCESS_TOKEN_TTL_SECONDS=43200

# File SQLite (created automatically on startup)
DATABASE_URL=sqlite+pysqlite:///./data/meeting_assistant.db
REDIS_URL=redis://localhost:6379/0

# Process jobs in-process (no Redis worker needed)
JOB_RUNNER=inline
AUDIO_PREPROCESS_MODE=mock
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/audio

# Leave empty = mock AI providers (zero OpenAI cost)
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_QA_MODEL=gpt-4o-mini

SEED_DEMO_ON_STARTUP=true
DEMO_USER_EMAIL=demo@example.com
MAX_UPLOADS_PER_IP_PER_DAY=20
REDACT_PII=true
MAX_AUDIO_MINUTES_PER_USER_PER_MONTH=30
MAX_LLM_TOKENS_PER_USER_PER_MONTH=500000
MAX_MEETINGS_PER_USER=50
MAX_QUESTIONS_PER_DAY=100
MAX_UPLOAD_BYTES=262144000
MAX_MEETING_DURATION_SECONDS=10800
TRANSCRIPTION_MAX_FILE_BYTES=25000000
SIGNED_URL_TTL_SECONDS=900
AUDIO_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=365
APP_VERSION=0.1.0

# Optional Supabase (production / Docker Compose path)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=meeting-audio

LOG_LEVEL=INFO
SENTRY_DSN=
